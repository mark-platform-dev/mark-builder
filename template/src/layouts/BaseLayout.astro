---
import "../styles/global.css"
import site from "../../data/site.yaml"

// `.astro` pages pass `meta` as a prop. `.mdx` pages with `layout:` in their
// frontmatter pass the whole frontmatter instead, so `meta` lives inside it.
const meta = Astro.props.meta ?? Astro.props.frontmatter?.meta ?? {}
const title = meta.title ? `${meta.title} · ${site.name}` : site.name
const description = meta.description ?? site.description

// Links are built from BASE_URL so the site also works under a sub-path
// (a GitHub Pages project site, for example). Data files keep root-relative
// hrefs like "/about/"; this prepends the base without doubling the slash.
// An absolute href (an external nav link) is left untouched.
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const url = (href) => (href.startsWith("/") ? base + href : href)
---

<!doctype html>
<html lang={site.lang ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={url("/")}>{site.name}</a>
      <nav class="site-nav">
        {site.nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .site-name {
    font-weight: 600;
    color: var(--color-foreground);
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    gap: 1rem;
  }
  .site-main {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
</style>
