---
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.jsx"
import Steps from "../components/Steps.jsx"
import Checklist from "../components/Checklist.jsx"

// A page is the composition root: it imports every data file the route
// needs and hands the pieces to components as props.
import home from "../../data/home.yaml"
---

<BaseLayout meta={home.meta}>
  <Hero d={home.hero} />
  <Steps d={home.steps} />
  <Checklist d={home.checklist} client:only="react" />
</BaseLayout>
